# Michi reader Environment Variables Configuration
# Copy this file to .env and configure values

# =============================================================================
# Core Configuration
# =============================================================================
# App environment: 'development' or 'production'
# Defaults to 'production' in deployed environments
ENVIRONMENT=development

# =============================================================================
# Data Storage
# =============================================================================
# Host path for persistent data (database, screenshots)
# In Docker, this is mounted to /app/data
# In local dev, this is usually disregarded in favor of relative ../data paths
DATA_DIR=./data

# =============================================================================
# Database
# =============================================================================
# SQLite database connection string
# For Docker: sqlite:////app/data/michireader.db
# For Local Dev: sqlite:///../data/michireader.db
DATABASE_URL=sqlite:///../data/michireader.db

# =============================================================================
# Security
# =============================================================================
# JWT secret key - CHANGE THIS IN PRODUCTION!
# Generate with: openssl rand -base64 32
SECRET_KEY=change-me-to-a-secure-random-string

# JWT Algorithm (default: HS256)
ALGORITHM=HS256

# Token expiration in minutes (default: 30 days = 43200)
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# =============================================================================
# Server Configuration
# =============================================================================
# External port for the application (default: 3000)
PORT=3000

# Hostname (used for CORS and display)
HOST=localhost

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# Worker Settings
# =============================================================================
# How often to check for new links (seconds)
POLL_INTERVAL=5

# Maximum retry attempts for failed archives
MAX_RETRIES=3

# Browser timeout for archiving (milliseconds)
TIMEOUT=30000

# Playwright settings
HEADLESS=true
