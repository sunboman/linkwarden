# Linkwarden v2 Production Environment Variables
# Copy this file to .env and configure values

# =============================================================================
# Data Storage
# =============================================================================
# Host path for persistent data (database, screenshots)
# This is mounted as a volume to /app/data inside the container
DATA_DIR=./data

# =============================================================================
# Database
# =============================================================================
# SQLite database path (relative to container's /app/data)
# Note: The actual DATABASE_URL is set in docker-compose.prod.yml
# DATABASE_URL=sqlite:////app/data/linkwarden.db

# =============================================================================
# Security
# =============================================================================
# JWT secret key - CHANGE THIS IN PRODUCTION!
# Generate with: openssl rand -base64 32
SECRET_KEY=your-secret-key-change-in-production

# =============================================================================
# Server Configuration
# =============================================================================
# External port for the application
PORT=3000

# Hostname (used for CORS and display)
HOST=localhost

# =============================================================================
# CORS (Cross-Origin Resource Sharing)
# =============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# =============================================================================
# Worker Settings
# =============================================================================
# How often to poll for new links to archive (seconds)
POLL_INTERVAL=5

# Maximum retry attempts for failed archives
MAX_RETRIES=3

# Browser timeout for archiving (milliseconds)
TIMEOUT=30000
